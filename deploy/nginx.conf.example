server {
    listen 443 ssl;
    server_name db-admin.internal;

    ssl_certificate     /etc/pki/tls/certs/dbwebui.crt;
    ssl_certificate_key /etc/pki/tls/private/dbwebui.key;

    # This app has no front controller — index.php, table.php, sql.php and the
    # rest are each requested directly. The document root is the app's own
    # checkout; only the directories with no business being web-facing
    # (tests, docs, git/editor metadata) are explicitly denied below.
    root /var/www/dbwebui;
    index index.php;

    location / {
        try_files $uri $uri/ =404;
    }

    location ~ \.php$ {
        fastcgi_pass unix:/run/php-fpm/dbwebui.sock;
        fastcgi_index index.php;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        include fastcgi_params;
    }

    location ^~ /tests/     { deny all; }
    location ^~ /docs/      { deny all; }
    location ~ \.sql$       { deny all; }
    location ~ /\.(?!well-known) { deny all; }
}

server {
    listen 80;
    server_name db-admin.internal;
    return 301 https://$host$request_uri;
}
